{
  "expo": {
    "name": "Imari",
    "slug": "imari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "imari",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.imari.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Imari uses the camera for QR code payments and KYC document capture.",
        "NSFaceIDUsageDescription": "Imari uses Face ID to keep your account secure.",
        "NSLocalNetworkUsageDescription": "Used for development only."
      }
    },
    "android": {
      "package": "app.imari.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0D1117",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#4F8EF7",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Imari to use Face ID."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Imari needs camera access for KYC identity verification and QR code payments."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Imari needs photo access to upload your identity document."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D1117",
          "dark": {
            "backgroundColor": "#0D1117"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ce69652-a9e4-4a5d-96db-4125f7a1cbfc"
      }
    },
    "owner": "block-industries"
  }
}
